{
  "name": "@linwooddev/starlight-style",
  "description": "Shared Starlight components and styling for Linwood documentation sites.",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "check": "astro check && pnpm test",
    "test": "node --test tests/*.test.mjs"

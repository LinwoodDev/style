  },
  "bugs": {
    "url": "https://github.com/LinwoodDev/style/issues"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.41.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@linwooddev/style": "^0.4.3",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/starlight": "^0.41.10",
    "@fontsource-variable/inter": "^5.3.0",

---
import { Image } from "astro:assets";
import "../styles/landing.scss";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  darkImage?: ImageMetadata;
  alt: string;
  reverse?: boolean;
}

const { image, darkImage, alt, reverse = false } = Astro.props;
---

<section class:list={["landing-feature", { reverse }]}>
  <div class="landing-feature__copy">
    <slot />
  </div>
  <div class="landing-feature__visual">
    <Image
      class:list={{ "dark:sl-hidden": Boolean(darkImage) }}
      src={image}
      alt={alt}
      widths={[480, 768, 1280]}
      sizes="(min-width: 90rem) 48rem, (min-width: 50rem) 55vw, 100vw"
      format="webp"
      loading="lazy"
    />
    {darkImage && (
      <Image
        class="light:sl-hidden"
        src={darkImage}
        alt={alt}
        widths={[480, 768, 1280]}
        sizes="(min-width: 90rem) 48rem, (min-width: 50rem) 55vw, 100vw"
        format="webp"
        loading="lazy"
      />
    )}
  </div>
</section>

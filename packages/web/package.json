{
  "name": "@linwooddev/style",
  "description": "A lightweight, customizable SCSS design system for Linwood web projects.",
  "version": "0.4.3",
  "scripts": {
    "check": "sass --no-source-map scss/:css/",
    "watch": "sass --watch scss/:css/",
    "build": "sass --style compressed scss/:css/"
  },
  "files": [
    "css/**/*.css",
    "css/**/*.css.map",
    "scss/**/*.scss"
  ],
  "sass": "scss/main.scss",
  "style": "css/main.css",
  "keywords": [
    "css",
    "design-system",
    "sass",
    "scss"
  ],
  "author": "Linwood",
  "license": "MIT",
  "homepage": "https://style.linwood.dev",
  "bugs": {
    "url": "https://github.com/LinwoodDev/style/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LinwoodDev/style.git",
    "directory": "packages/web"
  },
  "devDependencies": {
    "sass": "^1.103.1"
  },
  "publishConfig": {
    "access": "public"
  }
}

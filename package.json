{
  "private": true,
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm --recursive --if-present check && pnpm --filter docs build",
    "dev": "pnpm --filter docs dev",
    "ci:version": "changeset version",
    "ci:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2"
  },
  "engines": {
    "node": "^24.20.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.20.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.4"
}
